<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>SahandGearMaker.Screenshots</RootNamespace>
    <AssemblyName>sgm-screenshots</AssemblyName>
    <!-- ساخت کراس‌پلتفرم (اجرا فقط روی ویندوز) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SahandGearMaker.Domain\SahandGearMaker.Domain.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Math\SahandGearMaker.Math.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Geometry\SahandGearMaker.Geometry.csproj" />
    <ProjectReference Include="..\SahandGearMaker.App\SahandGearMaker.App.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Scene\SahandGearMaker.Scene.csproj" />
  </ItemGroup>

</Project>
