<UserControl x:Class="SahandGearMaker.App.Views.DrawingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- پیش‌نمایش نقشهٔ فنی -->
        <Border Grid.Column="0" Margin="6" Background="White" CornerRadius="8" ClipToBounds="True"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="SheetCanvas" Width="1120" Height="780" Background="White" Margin="12" />
                </ScrollViewer>
                <Border x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#F2FFFFFF" CornerRadius="10" Padding="28" BorderBrush="#33888" BorderThickness="1">
                    <TextBlock Text="قطعه‌ای برای نقشهٔ فنی انتخاب نشده — در تب طراح یک قطعهٔ معتبر بسازید."
                               FontSize="14" Foreground="#556" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- ستون کنترل -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6">
            <StackPanel>
                <TextBlock Text="نقشهٔ فنی قطعهٔ انتخابی" Style="{StaticResource SectionText}" Margin="4,0,4,8" />

                <GroupBox Header="قطعهٔ هدف">
                    <StackPanel>
                        <TextBlock Text="قطعه" Style="{StaticResource MutedText}" Margin="0,2" />
                        <ComboBox x:Name="PartCombo" SelectionChanged="PartCombo_SelectionChanged" Margin="0,2,0,8" />
                        <TextBlock x:Name="PartSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11.5" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="خروجی نقشه" Margin="0,8,0,0">
                    <StackPanel>
                        <Button Content="SVG برداری (فارسی)" Click="ExportSvg_Click" Margin="0,4" />
                        <Button Content="PDF (فارسی)" Click="ExportPdf_Click" Margin="0,4" Style="{StaticResource SecondaryButton}" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="نقشه شامل نما، جدول مشخصات و کادر عنوان است. متن فارسی با فونت وزیرمتن درون‌فایل جاسازی می‌شود." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="مشخصات نمایش‌داده‌شده" Margin="0,8,0,0">
                    <ItemsControl x:Name="FiguresList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key, Mode=OneWay}" FontSize="12" Foreground="#445" />
                                    <TextBlock Text="{Binding Value, Mode=OneWay}" FontSize="12" FontWeight="Bold"
                                               Grid.Column="1" FlowDirection="LeftToRight" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
