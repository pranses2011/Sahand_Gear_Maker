<UserControl x:Class="SahandGearMaker.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Center">

            <TextBlock Text="تنظیمات" Style="{StaticResource TitleText}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14"
                       Text="تنظیمات فوراً اعمال و در همین سیستم ذخیره می‌شود — هیچ داده‌ای به بیرون ارسال نمی‌شود." />

            <GroupBox Header="بوم سه‌بعدی">
                <StackPanel>
                    <TextBlock Text="سرعت چرخش با درگ" Style="{StaticResource MutedText}" Margin="0,2,0,2" />
                    <Slider x:Name="RotateSpeedSlider" Minimum="2" Maximum="20" Value="8"
                            ValueChanged="RotateSpeed_Changed" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <UniformGrid Columns="2">
                        <TextBlock Text="آرام" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Text="تند" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Left" />
                    </UniformGrid>

                    <CheckBox x:Name="InvertCheck" Content="وارونه‌سازی جهت افقی چرخش (برای کاربران چپ‌دست)"
                              Margin="0,8,0,4" Checked="Invert_Changed" Unchecked="Invert_Changed" />

                    <CheckBox x:Name="DarkCanvasCheck" Content="تم تیرهٔ بوم سه‌بعدی"
                              Margin="0,4,0,4" Checked="DarkCanvas_Changed" Unchecked="DarkCanvas_Changed" />

                    <CheckBox x:Name="GridCheck" Content="نمایش گرید به‌صورت پیش‌فرض"
                              Margin="0,4,0,4" Checked="Grid_Changed" Unchecked="Grid_Changed" />
                    <CheckBox x:Name="AxesCheck" Content="نمایش محورها به‌صورت پیش‌فرض"
                              Margin="0,4,0,4" Checked="Axes_Changed" Unchecked="Axes_Changed" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="خروجی و ذخیره‌سازی" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="واحد پیش‌فرض خروجی" Style="{StaticResource MutedText}" Margin="0,2,0,2" />
                    <ComboBox x:Name="UnitCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="Unit_Changed">
                        <ComboBoxItem Content="میلی‌متر" IsSelected="True" />
                        <ComboBoxItem Content="اینچ" />
                    </ComboBox>
                    <CheckBox x:Name="AutosaveCheck" Content="ذخیرهٔ خودکار هر ۲ دقیقه (فایل اصلی دست نمی‌خورد؛ نسخهٔ بازیابی کنار آن)"
                              Margin="0,8,0,4" Checked="Autosave_Changed" Unchecked="Autosave_Changed" IsChecked="True" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="مسیرها و داده‌ها" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="PathsText" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="حریم خصوصی" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap"
                               Text="این برنامه کاملاً آفلاین کار می‌کند. طراحی، ذخیره و خروجی بدون اینترنت انجام می‌شود. تنها ارتباط شبکه‌ایِ اختیاری، فرم بازخورد است که فقط با کلیک خودتان و در صورت پیکربندی سرور ارسال می‌شود؛ در غیر این صورت هیچ درخواست شبکه‌ای وجود ندارد." />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
