<UserControl x:Class="SahandGearMaker.App.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SahandGearMaker.App.Controls"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RightCol" Width="330" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="LeftCol" Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ستون راست: پارامترها (سند ۰۲، بخش ۶.۲ + فاز ۲٫۱) ═══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="پارامترهای قطعه" Style="{StaticResource SectionText}" Margin="4,0,4,8" />

                <GroupBox Header="نوع و نام">
                    <StackPanel>
                        <TextBlock Text="نام قطعه" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="PartName" LostFocus="PartName_LostFocus" KeyDown="Field_KeyDown" Margin="0,2,0,10" />

                        <TextBlock Text="خانوادهٔ هندسی (۱۹ خانواده)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <ComboBox x:Name="FamilyCombo" SelectionChanged="FamilyCombo_SelectionChanged" Margin="0,2,0,6" />
                        <TextBlock x:Name="FamilyNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="دندانه">
                    <StackPanel>
                        <TextBlock Text="تعداد دندانه (z)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="ToothCount" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="ماژول (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="Module" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="زاویهٔ فشار (درجه)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="PressureAngle" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="زاویهٔ مارپیچ (درجه)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="HelixAngle" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="پهنای دندانه (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="FaceWidth" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,4" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="سوراخ مرکزی و بدنه">
                    <StackPanel>
                        <TextBlock Text="شکل سوراخ مرکزی" Style="{StaticResource MutedText}" Margin="0,2" />
                        <ComboBox x:Name="BoreShapeCombo" SelectionChanged="BoreShape_SelectionChanged" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="قطر سوراخ مرکزی / بین-سر (mm)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="BoreDiameter" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock x:Name="BoreFlatLabel" Text="فاصلهٔ سطح تخت D از مرکز (mm — صفر = خودکار)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="BoreFlatDistance" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock x:Name="BoreSplineCountLabel" Text="تعداد خارهای هزارخار بور" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="BoreSplineCount" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock x:Name="BoreSplineDepthLabel" Text="ارتفاع خار بور (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="BoreSplineDepth" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock x:Name="KeywayWidthLabel" Text="پهنای شیار خار (mm — صفر = بدون خار)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="KeywayWidth" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,4" />
                        <TextBlock x:Name="KeywayDepthLabel" Text="عمق شیار خار (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="KeywayDepth" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="پخ دهانهٔ بور ۴۵° (mm — صفر = بدون)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="BoreChamfer" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="قطر توپی (mm — صفر = بدون توپی)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="HubDiameter" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,4" />
                        <TextBlock Text="طول توپی (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="HubLength" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="حفره‌های سبک‌سازی">
                    <StackPanel>
                        <TextBlock Text="شکل حفره" Style="{StaticResource MutedText}" Margin="0,2" />
                        <ComboBox x:Name="LighteningShapeCombo" SelectionChanged="LighteningShape_SelectionChanged" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="تعداد (صفر = بدون حفره)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="LighteningHoles" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="اندازهٔ حفره — قطر/بین-سر (mm)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="LighteningSize" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="شعاع دایرهٔ مرکز حفره‌ها (mm — صفر = خودکار)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="LighteningCircleRadius" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="چرخش همهٔ حفره‌ها (درجه)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="LighteningRotation" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <CheckBox x:Name="LighteningFollowTwist" Content="حفره‌ها همراه پیچش مارپیچ بچرخند (پیش‌فرض: بدون چرخش)" Checked="LighteningFollow_Changed" Unchecked="LighteningFollow_Changed" Margin="0,2,0,4" FlowDirection="RightToLeft" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="دندانه — پیشرفته">
                    <StackPanel>
                        <TextBlock Text="ضریب اصلاح پروفیل x" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="ProfileShift" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="لقی جانبی دندانه (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="BacklashAllowance" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="ضریب ارتفاع سر (ha*)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="AddendumCoef" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="ضریب عمق ریشه (hf*)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="DedendumCoef" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="ضریب شعاع فیلهٔ ریشه" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="RootFilletCoef" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="پخ نوک دندانه (mm — صفر = بدون)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="TipChamfer" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock x:Name="HerringboneGapLabel" Text="گپ مرکزی جناغی (mm — صفر = پیوسته)" Style="{StaticResource MutedText}" Margin="0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="HerringboneGap" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />
                    </StackPanel>
                </GroupBox>

                <!-- پارامترهای اختصاصی خانواده — فاز ۲٫۱: به‌صورت پویا ساخته می‌شود -->
                <GroupBox x:Name="FamilyParamsBox" Header="پارامترهای اختصاصی خانواده" Visibility="Collapsed">
                    <StackPanel x:Name="FamilyParamsPanel" />
                </GroupBox>

                <GroupBox Header="کیفیت مش">
                    <StackPanel>
                        <TextBlock Text="تلرانس وتر پروفیل (mm)" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="ProfileTolerance" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,8" />

                        <TextBlock Text="برش‌های عرضی مارپیچ" Style="{StaticResource MutedText}" Margin="0,2" />
                        <TextBox x:Name="AxialSlices" LostFocus="Numeric_LostFocus" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="140" Margin="0,2,0,4" />
                    </StackPanel>
                </GroupBox>

                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="بازسازی هندسه" Click="Rebuild_Click" Margin="0,0,4,0" />
                    <Button Content="بازسازی همه" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="RebuildAll_Click" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ مرکز: بوم حرفه‌ای (فاز ۱B/۱C) ═══ -->
        <Grid Grid.Column="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFEAEEF4" CornerRadius="8" ClipToBounds="True">
                <controls:ViewportControl x:Name="Viewport" />
            </Border>
        </Grid>

        <!-- ═══ ستون چپ: تب‌های درخت/گونه‌ها/پیام‌ها (فاز ۲٫۳/۲٫۴) ═══ -->
        <Grid Grid.Column="2" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="＋ قطعه" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="AddPart_Click" Padding="8,4" />
                <Button Content="تکثیر" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="DuplicatePart_Click" Padding="8,4" />
                <Button Content="حذف" Style="{StaticResource SecondaryButton}" Click="RemovePart_Click" Padding="8,4" />
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- ── تب درخت ── -->
                <TabItem Header="درخت">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- درخت پروژه — فاز ۱٫۲۱: چشم/قفل/رنگ/وضعیت -->
                        <GroupBox Grid.Row="0" Header="درخت پروژه">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PartsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Margin="1,1" Padding="6,4" CornerRadius="5"
                                                    Background="#FFF6F8FB" MouseLeftButtonUp="PartNode_Click"
                                                    Tag="{Binding Id}" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="{Binding EyeIcon, Mode=OneWay}" FontSize="12"
                                                            Background="Transparent" BorderThickness="0" Padding="2,0"
                                                            Click="Eye_Click" Tag="{Binding Id}" ToolTip="نمایش/مخفی" />
                                                    <Button Grid.Column="1" Content="{Binding LockIcon, Mode=OneWay}" FontSize="11"
                                                            Background="Transparent" BorderThickness="0" Padding="2,0"
                                                            Click="Lock_Click" Tag="{Binding Id}" ToolTip="قفل/بازکردن" />
                                                    <Border Grid.Column="2" Width="11" Height="11" CornerRadius="3" Margin="4,0"
                                                            Background="{Binding ColorHex, Mode=OneWay}" ToolTip="رنگ نمایشی" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Name, Mode=OneWay}" FontSize="12.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusBadge, Mode=OneWay}" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- جای‌گذاری و ظاهر شیئ — فاز ۱٫۲۲/۱٫۲۳ (O4/O5/O6) -->
                        <GroupBox Grid.Row="1" Header="جای‌گذاری و ظاهر قطعهٔ انتخابی" Margin="0,6,0,0">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="X (mm)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceX" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="Y (mm)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceY" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="Z (mm)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceZ" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="چرخش θ (درجه)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceTheta" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="مقیاس (۱=واقعی)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceScale" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="شفافیت (۰-۱)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceOpacity" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,4">
                                        <TextBlock Text="کج‌کردن حول X (درجه — مونتاژ ۳بعدی)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceThetaX" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="کج‌کردن حول Y (درجه — مثلاً ۹۰ = محور افقی)" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox x:Name="PlaceThetaY" LostFocus="Placement_LostFocus" FlowDirection="LeftToRight" FontSize="12" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="🎨 رنگ…" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" Click="PartColor_Click" />
                                    <Button Content="⌖ قاب این قطعه" Style="{StaticResource SecondaryButton}" Margin="4,0,0,4" Click="FramePart_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- نماهای نام‌دار — فاز ۱٫۱۶ -->
                        <GroupBox Grid.Row="2" Header="نماهای نام‌دار" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ViewName" Width="120" Margin="0,0,4,0" />
                                    <Button Content="ذخیرهٔ نما" Style="{StaticResource SecondaryButton}" Click="SaveView_Click" Padding="8,3" />
                                </StackPanel>
                                <ItemsControl x:Name="ViewsList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <Button Content="▶" Background="Transparent" BorderThickness="0" Padding="4,0"
                                                        Click="ApplyView_Click" Tag="{Binding Name}" ToolTip="اعمال نما" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Width="150" TextTrimming="CharacterEllipsis" />
                                                <Button Content="✕" Background="Transparent" BorderThickness="0" Padding="4,0"
                                                        Click="DeleteView_Click" Tag="{Binding Name}" ToolTip="حذف نما" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ── تب گونه‌ها و مرجع (فاز ۲٫۳/۲٫۴) ── -->
                <TabItem Header="گونه‌ها و مرجع">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="گونه‌ها (Variant)">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="VariantName" Width="120" Margin="0,0,4,0" />
                                        <Button Content="ثبت گونه" Style="{StaticResource SecondaryButton}" Click="RegisterVariant_Click" Padding="8,3" Margin="0,0,4,0" />
                                        <Button Content="مقایسه" Style="{StaticResource SecondaryButton}" Click="CompareVariants_Click" Padding="8,3" />
                                    </StackPanel>
                                    <ItemsControl x:Name="VariantsList" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <Button Content="⇩" Background="Transparent" BorderThickness="0" Padding="4,0" FontSize="13"
                                                            Click="ApplyVariant_Click" Tag="{Binding Name}" ToolTip="اعمال این گونه" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Width="170" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="VariantCompare" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Content="ذخیرهٔ گونه‌ها…" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" Click="SaveVariants_Click" FontSize="11" />
                                        <Button Content="بارگذاری گونه‌ها…" Style="{StaticResource SecondaryButton}" Margin="4,0,0,4" Click="LoadVariants_Click" FontSize="11" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap"
                                               Text="اعمال گونه، وضعیت فعلی را با «واگرد» قابل بازگشت می‌کند." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="مدل مرجع (STL/OBJ/PLY)" Margin="0,8,0,0">
                                <StackPanel>
                                    <Button Content="ورود مدل مرجع…" Click="ImportReference_Click" Margin="0,2" />
                                    <Button Content="حذف آخرین مرجع" Style="{StaticResource SecondaryButton}" Click="RemoveReference_Click" Margin="0,2" FontSize="11" />
                                    <TextBlock x:Name="ReferenceInfo" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="مدل مرجع به‌صورت شبح شفاف رسم می‌شود و هرگز به‌عنوان چرخ‌دندهٔ پارامتریک تفسیر نمی‌شود (سیاست صادقانه). حداکثر ۲ میلیون مثلث / ۴۰۰MB." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── تب پیام‌ها ── -->
                <TabItem Header="پیام‌ها">
                    <GroupBox Header="پیام‌ها و اعتبارسنجی">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiagnosticsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="8,6" CornerRadius="6" Background="#FFF1F5F9">
                                            <StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="#FF64748B"
                                                           Text="{Binding SeverityLabel, Mode=OneWay}" />
                                                <TextBlock FontSize="12.5" TextWrapping="Wrap"
                                                           Text="{Binding Message, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
