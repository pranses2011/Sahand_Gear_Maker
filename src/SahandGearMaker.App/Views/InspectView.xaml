<UserControl x:Class="SahandGearMaker.App.Views.InspectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SahandGearMaker.App.Controls"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ستون راست: ابزارها -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="6">
            <StackPanel>
                <TextBlock Text="بررسی و اندازه‌گیری" Style="{StaticResource SectionText}" Margin="4,0,4,8" />

                <!-- ۴٫۱ ابزار اندازه‌گیری -->
                <GroupBox Header="ابزار اندازه‌گیری (۴٫۱)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="در بوم طراح فعال می‌شود: هر کلیک یک نقطه می‌گیرد (M برای خاموش/روشن). دو نقطه = فاصله؛ سه نقطه = زاویه. تلرانس نمایشی: ۰٫۰۱ mm." />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button x:Name="BtnMeasure" Content="📏 فعال‌سازی" Click="ToggleMeasure_Click" Margin="0,0,4,0" />
                            <Button Content="پاک‌کردن نقاط" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="ClearMeasure_Click" />
                        </UniformGrid>
                        <TextBlock x:Name="MeasureResult" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="Bold" />
                    </StackPanel>
                </GroupBox>

                <!-- ۴٫۲ صفحهٔ برش -->
                <GroupBox Header="صفحهٔ برش نمایشی (۴٫۲)" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="برش نمایشی از بالا (Z) — هندسهٔ ذخیره‌شده و خروجی‌ها هرگز تغییر نمی‌کنند." />
                        <CheckBox x:Name="ClipEnabled" Content="فعال" Checked="Clip_Changed" Unchecked="Clip_Changed" Margin="0,6,0,2" />
                        <Slider x:Name="ClipSlider" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="Clip_Changed" IsEnabled="False" />
                        <TextBlock x:Name="ClipLabel" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </GroupBox>

                <!-- ۴٫۳ گزارش تحلیل هندسی -->
                <GroupBox Header="گزارش تحلیل هندسی (۴٫۳)" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="قطعهٔ هدف" Style="{StaticResource MutedText}" FontSize="11" />
                        <ComboBox x:Name="AnalysisPartCombo" Margin="0,2,0,6" />
                        <Button Content="محاسبهٔ گزارش" Click="Analyze_Click" />
                        <TextBlock x:Name="AnalysisResult" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <!-- ۴٫۳ بررسی برخورد تقریبی -->
                <GroupBox Header="بررسی برخورد تقریبی (۴٫۳)" Margin="0,8,0,0">
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,4,4">
                                <TextBlock Text="قطعهٔ A" Style="{StaticResource MutedText}" FontSize="11" />
                                <ComboBox x:Name="CollideACombo" FontSize="12" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,4">
                                <TextBlock Text="قطعهٔ B" Style="{StaticResource MutedText}" FontSize="11" />
                                <ComboBox x:Name="CollideBCombo" FontSize="12" />
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="بررسی برخورد (تقریب گسسته)" Style="{StaticResource SecondaryButton}" Click="Collide_Click" />
                        <TextBlock x:Name="CollideResult" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ستون چپ: نمای دوم ارتوگرافیک (۴٫۴ Split View) -->
        <Grid Grid.Column="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#E8FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نمای دوم (ارتوگرافیک):" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                    <ComboBox x:Name="SecondViewCombo" Width="100" FontSize="12" SelectionChanged="SecondView_Changed">
                        <ComboBoxItem Content="جلو" IsSelected="True" />
                        <ComboBoxItem Content="بالا" />
                        <ComboBoxItem Content="راست" />
                        <ComboBoxItem Content="ایزو" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="صحنهٔ همان بوم طراح — برای مقایسهٔ هم‌زمان دو نما" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#FFEAEEF4" CornerRadius="8" ClipToBounds="True">
                <controls:ViewportControl x:Name="SecondViewport" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
