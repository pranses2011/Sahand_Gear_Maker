<Application x:Class="SahandGearMaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SahandGearMaker.App"
             ShutdownMode="OnLastWindowClose">
    <!-- پنجرهٔ اصلی در App.OnStartup ساخته می‌شود (عنوان پنجره حاوی شمارهٔ نسخه از AppInfo است) -->
    <Application.Resources>

        <!-- ═══ مبدل‌های عمومی (صفحهٔ خروجی) ═══ -->
        <app:BoolToBrushConverter x:Key="BoolToDimBrush" TrueBrush="#FF1E293B" FalseBrush="#FFA8B0BC" />
        <app:BoolToVisibilityConverter x:Key="BoolToHidden" WhenTrue="Collapsed" WhenFalse="Visible" />

        <!-- ═══ پالت رنگ سند ۰۲، بخش ۸ ═══ -->
        <Color x:Key="ColorNavy">#FF142238</Color>
        <Color x:Key="ColorPrimary">#FF2563EB</Color>
        <Color x:Key="ColorTeal">#FF0F9D91</Color>
        <Color x:Key="ColorAmber">#FFE99A16</Color>
        <Color x:Key="ColorRed">#FFD64545</Color>
        <Color x:Key="ColorBgLight">#FFF5F7FA</Color>
        <Color x:Key="ColorSurface">#FFFFFFFF</Color>
        <Color x:Key="ColorText">#FF1E293B</Color>
        <Color x:Key="ColorTextMuted">#FF64748B</Color>

        <SolidColorBrush x:Key="BrushNavy" Color="{StaticResource ColorNavy}" />
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
        <SolidColorBrush x:Key="BrushTeal" Color="{StaticResource ColorTeal}" />
        <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}" />
        <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}" />
        <SolidColorBrush x:Key="BrushBgLight" Color="{StaticResource ColorBgLight}" />
        <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
        <SolidColorBrush x:Key="BrushBorder" Color="#FFD8DEE9" />

        <!-- ═══ فونت وزیرمتن — منبع محلی، بدون نیاز به نصب (سند ۰۵، بخش ۶) ═══ -->
        <FontFamily x:Key="FontVazirmatn">/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
        <FontFamily x:Key="FontVazirmatnMedium">/Assets/Fonts/Vazirmatn-Medium.ttf#Vazirmatn Medium</FontFamily>
        <FontFamily x:Key="FontVazirmatnBold">/Assets/Fonts/Vazirmatn-Bold.ttf#Vazirmatn Bold</FontFamily>

        <!-- ═══ تایپوگرافی پایه (سند ۰۲، بخش ۸) ═══ -->
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatn}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatnBold}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatnMedium}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- ═══ کنترل‌ها ═══ -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatnMedium}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFE2E8F0" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatn}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatn}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatn}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatnMedium}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatnMedium}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource FontVazirmatn}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

    </Application.Resources>
</Application>
