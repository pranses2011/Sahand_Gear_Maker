<Window x:Class="SahandGearMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SahandGearMaker.App.Views"
        Title="طراح چرخ‌دنده سهند — Sahand Gear Designer"
        Icon="Assets/app.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowState="Maximized"
        Background="{StaticResource BrushBgLight}"
        FontFamily="{StaticResource FontVazirmatn}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ نوار عنوان (سند ۰۲، بخش ۵) ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BrushNavy}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="22" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="طراح چرخ‌دنده سهند" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource FontVazirmatnBold}" Foreground="White" />
                        <TextBlock x:Name="AppSubtitle" Text="Sahand Gear Designer" FontSize="11" Foreground="#AAE2E8F0"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnNew" Content="پروژهٔ جدید" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnNew_Click" />
                    <Button x:Name="BtnOpen" Content="بازکردن" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpen_Click" />
                    <Button x:Name="BtnSave" Content="ذخیره" Margin="0,0,8,0" Click="BtnSave_Click" />
                    <Button x:Name="BtnUndo" Content="↷ واگرد" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnUndo_Click" ToolTip="Ctrl+Z" />
                    <Button x:Name="BtnRedo" Content="↶ ازنو" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnRedo_Click" ToolTip="Ctrl+Y" />
                    <Button x:Name="BtnExport" Content="خروجی…" Style="{StaticResource SecondaryButton}" Click="BtnExport_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ بدنه: ناوبری راست + محتوا (چیدمان RTL مطابق سند ۰۲) ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ناوبری در سمت راست پنجرهٔ RTL -->
            <Border Grid.Column="0" Width="190" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,0">
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged" Margin="8">
                    <ListBoxItem Content="🏠 خانه" Padding="10,10" AutomationProperties.Name="خانه" />
                    <ListBoxItem Content="⚙ طراح چرخ‌دنده" Padding="10,10" IsSelected="True" AutomationProperties.Name="طراح چرخ‌دنده" />
                    <ListBoxItem Content="🔗 مونتاژ" Padding="10,10" AutomationProperties.Name="مونتاژ" />
                    <ListBoxItem Content="📐 نقشهٔ فنی" Padding="10,10" AutomationProperties.Name="نقشهٔ فنی" />
                    <ListBoxItem Content="📦 خروجی" Padding="10,10" AutomationProperties.Name="خروجی" />
                    <ListBoxItem Content="🛠 بررسی" Padding="10,10" AutomationProperties.Name="بررسی و اندازه‌گیری" />
                    <ListBoxItem Content="✉ بازخورد" Padding="10,10" AutomationProperties.Name="بازخورد" />
                    <ListBoxItem Content="⚙️ تنظیمات" Padding="10,10" AutomationProperties.Name="تنظیمات" />
                    <ListBoxItem Content="ℹ درباره" Padding="10,10" AutomationProperties.Name="درباره" />
                </ListBox>
            </Border>

            <TabControl x:Name="Pages" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="10">
                <TabControl.Resources>
                    <!-- مخفی‌کردن نوار تب‌های خالی بالای صفحه — ناوبری از طریق فهرست سمت راست انجام می‌شود
                         (TabItem مخفی می‌شود اما محتوای تب انتخابی عادی نمایش داده می‌شود) -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem Header="" x:Name="TabHome">
                    <views:HomeView x:Name="HomeView" />
                </TabItem>
                <TabItem Header="" x:Name="TabDesigner">
                    <views:DesignerView x:Name="DesignerView" />
                </TabItem>
                <TabItem Header="" x:Name="TabAssembly">
                    <views:AssemblyView x:Name="AssemblyView" />
                </TabItem>
                <TabItem Header="" x:Name="TabDrawing">
                    <views:DrawingView x:Name="DrawingView" />
                </TabItem>
                <TabItem Header="" x:Name="TabExport">
                    <views:ExportView x:Name="ExportView" />
                </TabItem>
                <TabItem Header="" x:Name="TabInspect">
                    <views:InspectView x:Name="InspectView" />
                </TabItem>
                <TabItem Header="" x:Name="TabFeedback">
                    <views:FeedbackView x:Name="FeedbackView" />
                </TabItem>
                <TabItem Header="" x:Name="TabSettings">
                    <views:SettingsView x:Name="SettingsView" />
                </TabItem>
                <TabItem Header="" x:Name="TabAbout">
                    <views:AboutView />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ═══ نوار وضعیت ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="🔌 آفلاین — همهٔ امکانات هسته بدون اینترنت کار می‌کنند"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="آماده" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
