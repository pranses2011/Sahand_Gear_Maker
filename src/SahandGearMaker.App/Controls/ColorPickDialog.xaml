<Window x:Class="SahandGearMaker.App.Controls.ColorPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب رنگ قطعه" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="ToolWindow" Background="White">
    <StackPanel Margin="16">
        <TextBlock Text="رنگ نمایشی این قطعه را انتخاب کنید (فقط نمایش؛ خواص ساخت را تضمین نمی‌کند):"
                   TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10" />

        <WrapPanel x:Name="Palette">
            <!-- سوآچ‌ها در code-behind اضافه می‌شوند -->
        </WrapPanel>

        <Separator Margin="0,10" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="کد هگز:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
            <TextBox x:Name="HexBox" Width="110" FontSize="13" FlowDirection="LeftToRight"
                     Padding="6,4" TextChanged="HexBox_TextChanged" />
            <Border x:Name="Preview" Width="46" Height="26" CornerRadius="5" Margin="10,0"
                    BorderBrush="#33000000" BorderThickness="1" Background="#2563EB" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="تأیید" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True" />
            <Button Content="انصراف" Width="90" Style="{StaticResource SecondaryButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
