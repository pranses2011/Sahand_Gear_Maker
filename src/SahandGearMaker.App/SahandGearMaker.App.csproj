<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>SahandGearMaker.App</RootNamespace>
    <AssemblyName>SahandGearDesigner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0</AssemblyVersion>
    <FileVersion>0.4.0</FileVersion>
    <Product>Sahand Gear Designer</Product>
    <Company>سعید نجفی</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- اجازهٔ کامپایل پروژهٔ ویندوزی روی لینوکس/CI غیرویندوزی (فقط بیلد، نه اجرا) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  
    <ApplicationIcon>Assets\app.ico</ApplicationIcon></PropertyGroup>

  <ItemGroup>
    <!-- MVVM — MIT، نگهداری‌شده توسط تیم .NET -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  
    <Resource Include="Assets\app.ico" /></ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SahandGearMaker.Domain\SahandGearMaker.Domain.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Math\SahandGearMaker.Math.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Geometry\SahandGearMaker.Geometry.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Assembly\SahandGearMaker.Assembly.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Persistence\SahandGearMaker.Persistence.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Exports\SahandGearMaker.Exports.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Drawing\SahandGearMaker.Drawing.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Scene\SahandGearMaker.Scene.csproj" />
    <ProjectReference Include="..\SahandGearMaker.Cad\SahandGearMaker.Cad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- فونت وزیرمتن (OFL 1.1) — منبع محلی، بدون نیاز به نصب در ویندوز -->
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <None Include="Assets\Fonts\LICENSE-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
